{"bank":"ipip-neo-120","bankVersion":"official-2026-09-29","items":[{"facet":"N1","id":"IPIP-001","key":"+","text":"Worry about things."},{"facet":"E1","id":"IPIP-002","key":"+","text":"Make friends easily."},{"facet":"O1","id":"IPIP-003","key":"+","text":"Have a vivid imagination."},{"facet":"A1","id":"IPIP-004","key":"+","text":"Trust others."},{"facet":"C1","id":"IPIP-005","key":"+","text":"Complete tasks successfully."},{"facet":"N2","id":"IPIP-006","key":"+","text":"Get angry easily."},{"facet":"E2","id":"IPIP-007","key":"+","text":"Love large parties."},{"facet":"O2","id":"IPIP-008","key":"+","text":"Believe in the importance of art."},{"facet":"A2","id":"IPIP-009","key":"-","text":"Use others for my own ends."},{"facet":"C2","id":"IPIP-010","key":"+","text":"Like to tidy up."},{"facet":"N3","id":"IPIP-011","key":"+","text":"Often feel blue."},{"facet":"E3","id":"IPIP-012","key":"+","text":"Take charge."},{"facet":"O3","id":"IPIP-013","key":"+","text":"Experience my emotions intensely."},{"facet":"A3","id":"IPIP-014","key":"+","text":"Love to help others."},{"facet":"C3","id":"IPIP-015","key":"+","text":"Keep my promises."},{"facet":"N4","id":"IPIP-016","key":"+","text":"Find it difficult to approach others."},{"facet":"E4","id":"IPIP-017","key":"+","text":"Am always busy."},{"facet":"O4","id":"IPIP-018","key":"+","text":"Prefer variety to routine."},{"facet":"A4","id":"IPIP-019","key":"-","text":"Love a good fight."},{"facet":"C4","id":"IPIP-020","key":"+","text":"Work hard."},{"facet":"N5","id":"IPIP-021","key":"+","text":"Go on binges."},{"facet":"E5","id":"IPIP-022","key":"+","text":"Love excitement."},{"facet":"O5","id":"IPIP-023","key":"+","text":"Love to read challenging material."},{"facet":"A5","id":"IPIP-024","key":"-","text":"Believe that I am better than others."},{"facet":"C5","id":"IPIP-025","key":"+","text":"Am always prepared."},{"facet":"N6","id":"IPIP-026","key":"+","text":"Panic easily."},{"facet":"E6","id":"IPIP-027","key":"+","text":"Radiate joy."},{"facet":"O6","id":"IPIP-028","key":"+","text":"Tend to vote for liberal political candidates."},{"facet":"A6","id":"IPIP-029","key":"+","text":"Sympathize with the homeless."},{"facet":"C6","id":"IPIP-030","key":"-","text":"Jump into things without thinking."},{"facet":"N1","id":"IPIP-031","key":"+","text":"Fear for the worst."},{"facet":"E1","id":"IPIP-032","key":"+","text":"Feel comfortable around people."},{"facet":"O1","id":"IPIP-033","key":"+","text":"Enjoy wild flights of fantasy."},{"facet":"A1","id":"IPIP-034","key":"+","text":"Believe that others have good intentions."},{"facet":"C1","id":"IPIP-035","key":"+","text":"Excel in what I do."},{"facet":"N2","id":"IPIP-036","key":"+","text":"Get irritated easily."},{"facet":"E2","id":"IPIP-037","key":"+","text":"Talk to a lot of different people at parties."},{"facet":"O2","id":"IPIP-038","key":"+","text":"See beauty in things that others might not notice."},{"facet":"A2","id":"IPIP-039","key":"-","text":"Cheat to get ahead."},{"facet":"C2","id":"IPIP-040","key":"-","text":"Often forget to put things back in their proper place."},{"facet":"N3","id":"IPIP-041","key":"+","text":"Dislike myself."},{"facet":"E3","id":"IPIP-042","key":"+","text":"Try to lead others."},{"facet":"O3","id":"IPIP-043","key":"+","text":"Feel others' emotions."},{"facet":"A3","id":"IPIP-044","key":"+","text":"Am concerned about others."},{"facet":"C3","id":"IPIP-045","key":"+","text":"Tell the truth."},{"facet":"N4","id":"IPIP-046","key":"+","text":"Am afraid to draw attention to myself."},{"facet":"E4","id":"IPIP-047","key":"+","text":"Am always on the go."},{"facet":"O4","id":"IPIP-048","key":"-","text":"Prefer to stick with things that I know."},{"facet":"A4","id":"IPIP-049","key":"-","text":"Yell at people."},{"facet":"C4","id":"IPIP-050","key":"+","text":"Do more than what's expected of me."},{"facet":"N5","id":"IPIP-051","key":"-","text":"Rarely overindulge."},{"facet":"E5","id":"IPIP-052","key":"+","text":"Seek adventure."},{"facet":"O5","id":"IPIP-053","key":"-","text":"Avoid philosophical discussions."},{"facet":"A5","id":"IPIP-054","key":"-","text":"Think highly of myself."},{"facet":"C5","id":"IPIP-055","key":"+","text":"Carry out my plans."},{"facet":"N6","id":"IPIP-056","key":"+","text":"Become overwhelmed by events."},{"facet":"E6","id":"IPIP-057","key":"+","text":"Have a lot of fun."},{"facet":"O6","id":"IPIP-058","key":"+","text":"Believe that there is no absolute right and wrong."},{"facet":"A6","id":"IPIP-059","key":"+","text":"Feel sympathy for those who are worse off than myself."},{"facet":"C6","id":"IPIP-060","key":"-","text":"Make rash decisions."},{"facet":"N1","id":"IPIP-061","key":"+","text":"Am afraid of many things."},{"facet":"E1","id":"IPIP-062","key":"-","text":"Avoid contacts with others."},{"facet":"O1","id":"IPIP-063","key":"+","text":"Love to daydream."},{"facet":"A1","id":"IPIP-064","key":"+","text":"Trust what people say."},{"facet":"C1","id":"IPIP-065","key":"+","text":"Handle tasks smoothly."},{"facet":"N2","id":"IPIP-066","key":"+","text":"Lose my temper."},{"facet":"E2","id":"IPIP-067","key":"-","text":"Prefer to be alone."},{"facet":"O2","id":"IPIP-068","key":"-","text":"Do not like poetry."},{"facet":"A2","id":"IPIP-069","key":"-","text":"Take advantage of others."},{"facet":"C2","id":"IPIP-070","key":"-","text":"Leave a mess in my room."},{"facet":"N3","id":"IPIP-071","key":"+","text":"Am often down in the dumps."},{"facet":"E3","id":"IPIP-072","key":"+","text":"Take control of things."},{"facet":"O3","id":"IPIP-073","key":"-","text":"Rarely notice my emotional reactions."},{"facet":"A3","id":"IPIP-074","key":"-","text":"Am indifferent to the feelings of others."},{"facet":"C3","id":"IPIP-075","key":"-","text":"Break rules."},{"facet":"N4","id":"IPIP-076","key":"+","text":"Only feel comfortable with friends."},{"facet":"E4","id":"IPIP-077","key":"+","text":"Do a lot in my spare time."},{"facet":"O4","id":"IPIP-078","key":"-","text":"Dislike changes."},{"facet":"A4","id":"IPIP-079","key":"-","text":"Insult people."},{"facet":"C4","id":"IPIP-080","key":"-","text":"Do just enough work to get by."},{"facet":"N5","id":"IPIP-081","key":"-","text":"Easily resist temptations."},{"facet":"E5","id":"IPIP-082","key":"+","text":"Enjoy being reckless."},{"facet":"O5","id":"IPIP-083","key":"-","text":"Have difficulty understanding abstract ideas."},{"facet":"A5","id":"IPIP-084","key":"-","text":"Have a high opinion of myself."},{"facet":"C5","id":"IPIP-085","key":"-","text":"Waste my time."},{"facet":"N6","id":"IPIP-086","key":"+","text":"Feel that I'm unable to deal with things."},{"facet":"E6","id":"IPIP-087","key":"+","text":"Love life."},{"facet":"O6","id":"IPIP-088","key":"-","text":"Tend to vote for conservative political candidates."},{"facet":"A6","id":"IPIP-089","key":"-","text":"Am not interested in other people's problems."},{"facet":"C6","id":"IPIP-090","key":"-","text":"Rush into things."},{"facet":"N1","id":"IPIP-091","key":"+","text":"Get stressed out easily."},{"facet":"E1","id":"IPIP-092","key":"-","text":"Keep others at a distance."},{"facet":"O1","id":"IPIP-093","key":"+","text":"Like to get lost in thought."},{"facet":"A1","id":"IPIP-094","key":"-","text":"Distrust people."},{"facet":"C1","id":"IPIP-095","key":"+","text":"Know how to get things done."},{"facet":"N2","id":"IPIP-096","key":"-","text":"Am not easily annoyed."},{"facet":"E2","id":"IPIP-097","key":"-","text":"Avoid crowds."},{"facet":"O2","id":"IPIP-098","key":"-","text":"Do not enjoy going to art museums."},{"facet":"A2","id":"IPIP-099","key":"-","text":"Obstruct others' plans."},{"facet":"C2","id":"IPIP-100","key":"-","text":"Leave my belongings around."},{"facet":"N3","id":"IPIP-101","key":"-","text":"Feel comfortable with myself."},{"facet":"E3","id":"IPIP-102","key":"-","text":"Wait for others to lead the way."},{"facet":"O3","id":"IPIP-103","key":"-","text":"Don't understand people who get emotional."},{"facet":"A3","id":"IPIP-104","key":"-","text":"Take no time for others."},{"facet":"C3","id":"IPIP-105","key":"-","text":"Break my promises."},{"facet":"N4","id":"IPIP-106","key":"-","text":"Am not bothered by difficult social situations."},{"facet":"E4","id":"IPIP-107","key":"-","text":"Like to take it easy."},{"facet":"O4","id":"IPIP-108","key":"-","text":"Am attached to conventional ways."},{"facet":"A4","id":"IPIP-109","key":"-","text":"Get back at others."},{"facet":"C4","id":"IPIP-110","key":"-","text":"Put little time and effort into my work."},{"facet":"N5","id":"IPIP-111","key":"-","text":"Am able to control my cravings."},{"facet":"E5","id":"IPIP-112","key":"+","text":"Act wild and crazy."},{"facet":"O5","id":"IPIP-113","key":"-","text":"Am not interested in theoretical discussions."},{"facet":"A5","id":"IPIP-114","key":"-","text":"Boast about my virtues."},{"facet":"C5","id":"IPIP-115","key":"-","text":"Have difficulty starting tasks."},{"facet":"N6","id":"IPIP-116","key":"-","text":"Remain calm under pressure."},{"facet":"E6","id":"IPIP-117","key":"+","text":"Look at the bright side of life."},{"facet":"O6","id":"IPIP-118","key":"-","text":"Believe that we should be tough on crime."},{"facet":"A6","id":"IPIP-119","key":"-","text":"Try not to think about the needy."},{"facet":"C6","id":"IPIP-120","key":"-","text":"Act without thinking."}],"scale":{"1":"Very Inaccurate","2":"Moderately Inaccurate","3":"Neither Inaccurate nor Accurate","4":"Moderately Accurate","5":"Very Accurate"},"source":"International Personality Item Pool; published administration order: Johnson (2014)"}